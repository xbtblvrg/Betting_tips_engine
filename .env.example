# Copy to .env. This file contains no credentials. Shell environment wins.
# Relative paths are resolved from the repository root.
BETTING_DATA_DIR=data
BETTING_ALLOWED_HOSTS=localhost,127.0.0.1
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
# Optional AI executables; install and log in separately before enabling workers.
CODEX_BIN=codex
CLAUDE_BIN=claude
AGY_BIN=agy
GROK_BIN=grok
NODE_BIN=node
# Optional: this machine's Tailscale HTTPS hostname, without scheme or port.
BETTING_TAILSCALE_HOST=
# Public Stake and Polymarket read-only endpoints need no trading credentials.
# Automatic betting is not implemented. Never add wallet/private keys here.
